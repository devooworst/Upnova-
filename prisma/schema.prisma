// ---------------------------------------------------------------------
// UpNova — production data model
//
// Dev runs on SQLite (zero-config sandbox). The schema is written to be
// portable to Postgres for production: switch the datasource provider,
// convert the String "enum" fields to real enums, and apply the Row
// Level Security policies documented in db/rls.sql. Until then, every
// route handler enforces the same ownership rules in the app layer via
// lib/server/authz.ts — no mutation happens without an ownership check.
//
// Seed separation: every seeded record carries isSeed=true so demo data
// can be wiped (`npm run db:reset-seed`) without touching real users.
// ---------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------- identity -------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  handle       String   @unique
  role         String   @default("user") // user | admin
  plan         String   @default("free") // free | college | pro
  status       String   @default("active") // active | suspended
  isSeed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  profile             Profile?
  sessions            Session[]
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  following           Follow[]              @relation("follower")
  followers           Follow[]              @relation("following")
  conversations       ConversationMember[]
  messages            Message[]
  notifications       Notification[]        @relation("notifTarget")
  actedNotifications  Notification[]        @relation("notifActor")
  communities         CommunityMember[]
  ownedCommunities    Community[]
  campusVerifications CampusVerification[]
  services            Service[]
  opportunities       Opportunity[]
  applications        Application[]
  clientProjects      Project[]             @relation("client")
  creatorProjects     Project[]             @relation("creator")
  extensionRequests   ExtensionRequest[]
  bookingsAsClient    Booking[]             @relation("bookingClient")
  bookingsAsProvider  Booking[]             @relation("bookingProvider")
  portfolioItems      PortfolioItem[]
  experiences         Experience[]
  reviewsWritten      Review[]              @relation("reviewAuthor")
  reviewsReceived     Review[]              @relation("reviewSubject")
  paymentsSent        Payment[]             @relation("payer")
  paymentsReceived    Payment[]             @relation("payee")
  reportsFiled        Report[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String  @default("")
  avatarUrl   String?
  coverUrl    String?
  coverPos    Int     @default(50)
  verified    Boolean @default(false)

  // location — exact coordinates are never exposed via the public API,
  // only used server-side for distance scoping
  city    String @default("")
  state   String @default("")
  county  String @default("")
  country String @default("")
  lat     Float?
  lng     Float?

  // professional identity (JSON-encoded string arrays — SQLite has no Json)
  primaryRole     String @default("")
  additionalRoles String @default("[]")
  skills          String @default("[]")
  interests       String @default("[]")
  serviceArea     String @default("25 miles")

  // availability + hiring
  openToWork     Boolean @default(true)
  availableFor   String  @default("[]")
  availableFrom  String  @default("") // "" = now
  workLocation   String  @default("Hybrid") // Local | Remote | Hybrid
  minBudget      Int?
  collabPref     String  @default("Either") // Paid | Collaboration | Either
  hiringEnabled  Boolean @default(true)
  acceptOffers   Boolean @default(true)
  acceptBookings Boolean @default(true)
  acceptCollabs  Boolean @default(true)

  // contact + privacy
  whoCanMessage         String  @default("everyone") // everyone | following | worked | nobody
  visibility            String  @default("public") // public | members | private
  showLocation          Boolean @default(true)
  showEducation         Boolean @default(true)
  showFollowers         Boolean @default(true)
  showFollowing         Boolean @default(true)
  showPortfolio         Boolean @default(true)
  showCompletedProjects Boolean @default(true)
  showWorkPerformance   Boolean @default(true)
  showAvailability      Boolean @default(true)

  links      String @default("[]") // [{platform,url}]
  trustLevel String @default("standard") // standard | identity | high-trust
}

// ------------------------------- social -------------------------------

model Post {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  imageUrl  String?
  kind      String    @default("post") // post | opportunity | service | poll | event
  isSeed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  comments  Comment[]
  likes     Like[]

  @@index([authorId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model Follow {
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

// ------------------------------ messaging ------------------------------

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]
  projects  Project[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("notifTarget", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("notifActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String // message | follow | project_offer | project_accepted | extension_requested | extension_approved | project_submitted | project_approved | payment | community | application | like
  category  String    @default("activity") // activity | work | messages | communities | campus | payments
  priority  String    @default("normal") // high | normal | low
  title     String
  body      String    @default("")
  href      String // every notification has somewhere meaningful to go
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ------------------------------ communities ------------------------------

model Community {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String            @default("")
  access      String            @default("public") // public | private | invite | verified
  mode        String            @default("discussion") // discussion | announcements | broadcast | collaboration | qa
  avatarUrl   String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  isSeed      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  members     CommunityMember[]
}

model CommunityMember {
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // member | moderator | owner
  joinedAt    DateTime  @default(now())

  @@id([communityId, userId])
}

// -------------------------------- campus --------------------------------

model Campus {
  id            String               @id @default(cuid())
  slug          String               @unique
  name          String
  city          String               @default("")
  state         String               @default("")
  isSeed        Boolean              @default(false)
  verifications CampusVerification[]
}

model CampusVerification {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusId String
  campus   Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  // status only — verification evidence/documents are NEVER stored here.
  // A production deployment points evidenceRef at a private object-store
  // key readable only by the verification service, never the public API.
  status      String    @default("pending") // pending | verified | rejected
  evidenceRef String?
  program     String    @default("")
  gradYear    String    @default("")
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, campusId])
}

// ------------------------------ marketplace ------------------------------

model Service {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  // price is the creator's payout; the buyer pays the 5% platform fee on top
  price         Int
  category      String  @default("creative")
  aiPolicy      String  @default("client-decides") // no-ai | disclosure | assisted | client-decides
  trustRequired String  @default("standard") // standard | identity | high-trust
  reach         String  @default("Remote")
  active        Boolean @default(true)
  paused        Boolean @default(false)
  isSeed        Boolean @default(false)
  createdAt     DateTime @default(now())
  projects      Project[]
  bookings      Booking[]
}

model Opportunity {
  id              String        @id @default(cuid())
  posterId        String
  poster          User          @relation(fields: [posterId], references: [id], onDelete: Cascade)
  title           String
  description     String        @default("")
  budget          Int? // null = collaboration / unpaid
  type            String        @default("gig") // gig | collab | event | campus
  location        String        @default("")
  lat             Float?
  lng             Float?
  remote          Boolean       @default(false)
  studentFriendly Boolean       @default(false)
  trustRequired   String        @default("standard")
  applyBy         DateTime?
  eventDate       DateTime?
  status          String        @default("open") // open | closed | filled
  isSeed          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  applications    Application[]
  projects        Project[]
}

model Application {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  message       String      @default("")
  availability  String      @default("yes") // yes | need_check
  status        String      @default("submitted") // submitted | shortlisted | selected | declined
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, applicantId])
}

// -------------------------------- projects --------------------------------

model Project {
  id             String        @id @default(cuid())
  clientId       String
  client         User          @relation("client", fields: [clientId], references: [id])
  creatorId      String
  creator        User          @relation("creator", fields: [creatorId], references: [id])
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String
  brief          String        @default("")
  // amount is the creator's payout in whole dollars; fee is computed at payment time
  amount        Int
  aiRequirement String   @default("client-decides")
  deadline      DateTime?
  // draft → offer_sent → accepted → in_progress → extension_requested →
  // submitted → approved → completed → reviewed  (lib/server/projects.ts
  // is the single transition authority — no other code writes state)
  state     String   @default("draft")
  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones ProjectMilestone[]
  extensions ExtensionRequest[]
  reviews    Review[]
  payments   Payment[]

  @@index([clientId])
  @@index([creatorId])
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime?
  status    String    @default("pending") // pending | done
  order     Int       @default(0)
}

model ExtensionRequest {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  days          Int
  reason        String    @default("")
  status        String    @default("pending") // pending | approved | denied
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([projectId, status])
}

// -------------------------------- bookings --------------------------------

model Booking {
  id          String   @id @default(cuid())
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientId    String
  client      User     @relation("bookingClient", fields: [clientId], references: [id])
  providerId  String
  provider    User     @relation("bookingProvider", fields: [providerId], references: [id])
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  price       Int
  location    String   @default("")
  status      String   @default("pending") // pending | confirmed | completed | cancelled
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([providerId, startsAt])
}

// ------------------------- portfolio / experience -------------------------

model PortfolioItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("image") // image | video | audio | link | project | upnova_project
  mediaUrl  String?
  client    String   @default("")
  projectId String? // when sourced from a completed UpNova project
  aiInvolvement String @default("none")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Experience {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position     String
  organization String
  start        String
  end          String  @default("") // "" = present
  description  String  @default("")
  location     String  @default("")
  order        Int     @default(0)
}

// --------------------------- reviews / payments ---------------------------

model Review {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("reviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User     @relation("reviewSubject", fields: [subjectId], references: [id])
  rating    Float
  body      String   @default("")
  createdAt DateTime @default(now())

  @@unique([projectId, authorId]) // mutual reviews: one per side per project
}

model Payment {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payerId   String
  payer     User     @relation("payer", fields: [payerId], references: [id])
  payeeId   String
  payee     User     @relation("payee", fields: [payeeId], references: [id])
  // amounts in cents; amount = creator payout, fee = 5% buyer-side platform fee
  amountCents Int
  feeCents    Int
  status      String  @default("pending") // pending | held | released | refunded
  // NO card data is ever stored. provider/providerRef are the seam where
  // Stripe Connect slots in: providerRef holds the PaymentIntent /
  // Transfer id, and webhooks drive status transitions.
  provider    String  @default("stripe_connect")
  providerRef String?
  createdAt   DateTime @default(now())
}

// ------------------------------- moderation -------------------------------

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String // user | post | message | service | opportunity | community | project
  targetId   String
  category   String // payment | creator | creative-integrity | safety | emergency
  details    String   @default("")
  status     String   @default("open") // open | reviewing | resolved | dismissed
  createdAt  DateTime @default(now())
}
