# ============================== PRODUCTION ==============================
# REQUIRED on Vercel Production (VERCEL_ENV=production). The app FAILS
# CLOSED without it — no PGlite fallback in production.
# DATABASE_URL="postgres://user:pass@host/db"

# Vercel Blob uploads (auto-injected by Vercel when a Blob store is linked)
# BLOB_READ_WRITE_TOKEN=

# ============================ DEMO / PREVIEW ============================
# Demo mode is automatic on Vercel Preview and wherever db/DEMO_MODE
# exists. On Vercel Production it is FORCED OFF in code regardless of
# these flags: demo tokens are rejected, demo seeding is skipped, and
# the seed script refuses to run.

# demo mode on deployments without the committed db/DEMO_MODE marker
# MAVYN_DEMO_MODE=1

# demo-only: show seeded dev logins on the sign-in page. Ignored in production builds unless set there explicitly — never do that.
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=1

# demo only: skip session cookies entirely (Bearer-token transport instead)
# MAVYN_DISABLE_SESSION_COOKIES=1

# demo only: sandbox-side sticky session for storage-blocked embeds. Hard-off on Vercel Production.
# MAVYN_DEMO_STICKY_SESSION=1

# =========================== EMERGENCY ONLY =============================
# Re-enables demo auth + seeding ON PRODUCTION. Exists for emergency
# diagnosis of a staging clone. NEVER set on a real deployment.
# MAVYN_FORCE_DEMO_IN_PRODUCTION=1

# ============================== JOB RUNNER ==============================
# Vercel Cron calls GET /api/jobs/tick every 10 minutes (vercel.json).
# Set CRON_SECRET on the Vercel project: Vercel automatically sends it as
# the Authorization header on cron invocations, and the route requires it.
# Production FAILS CLOSED (503) if no secret is configured.
# CRON_SECRET=
# alternative name for non-Vercel schedulers
# JOBS_TICK_SECRET=
