# Postgres connection (Neon on Vercel; leave unset locally to use the
# embedded PGlite database at db/pgdata)
# DATABASE_URL="postgres://user:pass@host/db"

# Vercel Blob uploads (auto-injected by Vercel when a Blob store is linked)
# BLOB_READ_WRITE_TOKEN=

# demo mode on deployments without the committed db/DEMO_MODE marker
# MAVYN_DEMO_MODE=1

# demo-only: show seeded dev logins on the sign-in page. NEVER set in production.
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=1

# demo only: skip session cookies entirely (Bearer-token transport instead)
# MAVYN_DISABLE_SESSION_COOKIES=1

# demo only: sandbox-side sticky session for storage-blocked embeds. NEVER set in production.
# MAVYN_DEMO_STICKY_SESSION=1
