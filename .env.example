DATABASE_URL="file:./dev.db"
SESSION_SECRET="dev-only-change-in-production"

# demo-only: show seeded dev logins on the sign-in page. NEVER set in production.
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=1

# demo only: skip session cookies entirely (Bearer-token transport instead)
# UPNOVA_DISABLE_SESSION_COOKIES=1

# demo only: sandbox-side sticky session for storage-blocked embeds. NEVER set in production.
# UPNOVA_DEMO_STICKY_SESSION=1
